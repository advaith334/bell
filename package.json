{
  "name": "pilcrow",
  "productName": "Pilcrow",
  "version": "0.1.0",
  "description": "Highlight any text, hit a hotkey, hear it read aloud",
  "main": ".vite/build/main.js",
  "license": "MIT",
  "author": {
    "name": "Advaith Karthikeyan"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:helper": "./swift-helper/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "release": "./scripts/release.sh",
    "stripe:bootstrap": "node --experimental-strip-types scripts/stripe-bootstrap.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "he": "^1.2.0",
    "jose": "^6.2.10",
    "ky": "^2.1.0",
    "openid-client": "^6.8.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/he": "^1.2.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.19"
  },
  "comments": {
    "electron": "Must stay on a build whose Node provides N-API 10 or newer (Electron 35+). better-sqlite3's shipped prebuild targets N-API 10; on an older Electron it segfaults at native module registration rather than failing gracefully."
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron@43.2.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
